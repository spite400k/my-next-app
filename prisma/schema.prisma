generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String  @id @default(cuid())
  name           String?
  email          String  @unique
  emailVerified  DateTime?
  password       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model keyWord {
  id       Int    @id @default(autoincrement())
  selectedCategory String
  customTopic     String
  selectedTopic   String
  selectedAge     String  // 配列ではなく文字列として保存
  selectedSex     String  // 配列ではなく文字列として保存
  createdAt DateTime @default(now())
}
